{
  "manifest_version": 2,
  "name": "Spotify Friend Activity",
  "version": "2.1.0",
  "page_action": {
    "default_icon": {
      "16": "images/sfa16.png",
      "24": "images/sfa24.png",
      "32": "images/sfa32.png"
    },
    "default_title": "Spotify Friend Activity",
    "default_popup": "popup.html"
  },
  "description": "View your friends' activity in Spotify's web player.",
  "icons": {
    "16": "images/sfa16.png",
    "48": "images/sfa48.png",
    "128": "images/sfa128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://open.spotify.com/*"],
      "js": ["index.js"]
    },
    {
      "matches": ["https://open.spotify.com/*"],
      "js": ["injectInterceptor.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": ["sfaInterceptor.js"],
  "permissions": [
    "storage",
    "https://open.spotify.com/*",
    "https://guc-spclient.spotify.com/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "{df11e835-904c-451f-b2eb-b6b32c3dd0a1}"
    }
  }
}
